# Copia este archivo como .env solamente en el VPS. Nunca lo subas a Git.
# Debe cumplir la política de SQL Server: mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=CAMBIAR_EN_EL_VPS
DB_APP_PASSWORD=CAMBIAR_EN_EL_VPS
JWT_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_DE_AL_MENOS_64_CARACTERES

# Digifact permanece en pruebas hasta autorizar explícitamente producción.
DIGIFACT_ENABLED=true
DIGIFACT_ENVIRONMENT=Test
DIGIFACT_BASE_URL=https://testnucgt.digifact.com/api/
DIGIFACT_TAX_ID=70361894
DIGIFACT_USERNAME=TESTUSER
DIGIFACT_PASSWORD=CAMBIAR_EN_EL_VPS

# Brevo se habilitará cuando el dominio haya sido autenticado.
SMTP_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM=no-responder@azesher.com
SMTP_FROM_NAME=Aze-Sher
SMTP_USERNAME=CAMBIAR_EN_EL_VPS
SMTP_PASSWORD=CAMBIAR_EN_EL_VPS
